# Neon: pooled connection string (host contains "-pooler") for the app
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
# Neon: direct connection string, used only by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

# openssl rand -base64 48
JWT_SECRET=""
# openssl rand -base64 32   (encrypts WhatsApp access tokens at rest)
ENCRYPTION_KEY=""

# Meta app dashboard > App settings > Basic > App secret
META_APP_SECRET=""
# Any long random string you choose; paste the same value into Meta's webhook setup
META_VERIFY_TOKEN=""
# Check Meta's changelog for the current version
GRAPH_API_VERSION="v25.0"

# One-click WhatsApp connect (Embedded Signup). See the README for how to get these from Meta.
META_APP_ID=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""

OPENAI_API_KEY=""

# Public address of the web app (used in password reset and verification emails)
APP_URL="http://localhost:5173"
# Email via Resend (resend.com). Leave blank to print emails to the console while developing.
RESEND_API_KEY=""
EMAIL_FROM="Everychat <no-reply@your-domain.com>"
# Emails that may open the platform admin panel, comma separated
PLATFORM_ADMIN_EMAILS=""

# Sign-in cookie. Keep "lax" and put the web app and API on one site (app.example.com + api.example.com),
# then set COOKIE_DOMAIN=.example.com in production. Leave COOKIE_DOMAIN empty for local development.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Error monitoring: create a Node.js project at sentry.io and paste its DSN. Optional.
SENTRY_DSN=""
# Spend protection (see README). 0 means no limit.
DEFAULT_DAILY_AI_TOKEN_LIMIT=1000000
AI_MAX_REPLIES_PER_CONVERSATION_PER_HOUR=20
# Unanswered-message recovery
RECOVERY_ENABLED=true
RECOVERY_MAX_AGE_MINUTES=120
# The chat model you want replying to customers (check OpenAI's current model list)
OPENAI_CHAT_MODEL=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
